[Unit]
Description=ConsultIQ FastAPI App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/consultiq
EnvironmentFile=/opt/consultiq/.env
ExecStart=/opt/consultiq/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
